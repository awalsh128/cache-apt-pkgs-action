{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "ts-apt": [
        "./node_modules/ts-apt/src/index.ts"
      ],
      "ts-apt/*": [
        "./node_modules/ts-apt/src/*"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023"
    ],
  }
}